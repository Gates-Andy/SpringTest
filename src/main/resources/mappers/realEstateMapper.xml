<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.andy.test.mybatis.repository.RealEstateRepository">

	<!-- 1번 select -->
	<select id="selectRealEstate" parameterType="int"
		resultType="com.andy.test.mybatis.domain.RealEstate">
		SELECT
		`id`
		,`realtorId`
		,`address`
		,`area`
		,`type`
		,`price`
		,`rentPrice`
		,`createdAt`
		,`updatedAt`
		FROM
		`real_estate`
		WHERE
		`id` = #{id}
	</select>

	<!-- 2번 select -->
	<select id="selectRealEstateByRentPrice" parameterType="int"
		resultType="com.andy.test.mybatis.domain.RealEstate">
		SELECT
		`id`
		,`realtorId`
		,`address`
		,`area`
		,`type`
		,`price`
		,`rentPrice`
		,`createdAt`
		,`updatedAt`
		FROM
		`real_estate`
		WHERE
		`rentPrice` <![CDATA[<]]>
		#{rentPrice}
		<!-- or -->
		<!-- <![CDATA[ `rentPrice` < #{rentPrice} ]]> -->
	</select>

	<!-- 3번 select 2개이상이니까 map임 -->
	<select id="selectRealEstateByAreaAndPrice" parameterType="map"
		resultType="com.andy.test.mybatis.domain.RealEstate">
		SELECT
		`id`
		,`realtorId`
		,`address`
		,`area`
		,`type`
		,`price`
		,`rentPrice`
		,`createdAt`
		,`updatedAt`
		FROM
		`real_estate`
		WHERE <![CDATA[
			`area` >= #{area} AND `price` <= #{price}
				]]>
	</select>

	<!-- 4번 insert -->
	<insert id="insertRealEstateByObject"
		parameterType="com.andy.test.mybatis.domain.RealEstate">
		INSERT INTO
		`real_estate`
		(
		`realtorId`
		,`address`
		,`area`
		,`type`
		,`price`
		)
		VALUE
		(
		#{realtorId}
		,#{address}
		,#{area}
		,#{type}
		,#{price}
		)
	</insert>

	<!-- 5번 insert -->
	<insert id="insertRealEstate"
		parameterType="com.andy.test.mybatis.domain.RealEstate">
		INSERT INTO
		`real_estate`
		(
		`realtorId`
		,`address`
		,`area`
		,`type`
		,`price`
		,`rentPrice`
		)
		VALUE
		(
		#{realtorId}
		,#{address}
		,#{area}
		,#{type}
		,#{price}
		,#{rentPrice}
		)
	</insert>

	<!-- 6번 update -->
	<update id="updateRealEstate" parameterType="map">
		UPDATE
		`real_estate`
		SET
		`type` = #{type}
		,`price`= #{price}
		,`updatedAt`= NOW()
		WHERE
		`id` =
		#{id}
	</update>

	<!-- 7번 delete -->
	<delete id="deleteRealEstate" parameterType="int">
		DELETE
		FROM
		`real_estate`
		WHERE
		`id` = #{id}
	</delete>

</mapper>