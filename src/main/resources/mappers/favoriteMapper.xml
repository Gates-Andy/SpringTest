<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.andy.test.ajax.repository.FavoriteRepository">

	<insert id="insertFavorite"
		parameterType="com.andy.test.ajax.domain.Favorite">
		INSERT INTO
		`favorite`
		(
		name
		, url
		)
		VALUES
		(
		#{name}
		, #{url}
		)
	</insert>

</mapper>