<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.andy.test.ajax.repository.FavoriteRepository">
	<!-- 1 -->
	<select id="selectFavoriteList"
		resultType="com.andy.test.ajax.domain.Favorite">
		SELECT
		`id`
		,`name`
		,`url`
		FROM
		`favorite`
	</select>
	
	<!-- 2 -->
	<insert id="insertFavoriteList" parameterType="map">
		INSERT INTO
		`favorite`
		(
		`name`
		,`url`
		)
		VALUE
		(
		#{name}
		,#{url}
		)
	</insert>
</mapper>