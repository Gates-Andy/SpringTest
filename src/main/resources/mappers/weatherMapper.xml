<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.andy.test.thymleaf.repository.WeatherRepository">

	<select id="selectWeather"
		resultType="com.andy.test.thymleaf.domain.Weather">
		SELECT
		`id`
		,`date`
		,`weather`
		,`temperatures`
		,`precipitation`
		,`microDust`
		,`windSpeed`

		FROM
		`weatherHistory`

	</select>

	<insert id="insertWeather"
		parameterType="com.andy.test.thymleaf.domain.Weather">
		INSERT INTO 
		`weatherHistory`
		(
		`date`
		, `weather`
		, `temperatures`
		, `precipitation`
		, `microDust`
		, `windSpeed`
		)
		VALUES
		(
		#{date}
		, #{weather}
		, #{temperatures}
		, #{precipitation}
		, #{microDust}
		,#{windSpeed}
		)
	</insert>
</mapper>