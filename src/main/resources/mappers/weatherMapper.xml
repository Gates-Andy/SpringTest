<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.andy.test.thymleaf.repository.WeatherRepository;">

	<select id="selectWheather"
		resultType="com.andy.test.thymleaf.domain.Weather">
		SELECT
		`id`
		,`date`
		,`weather`
		,`tempertaures`
		,`precipitation`
		,`microDust`
		,`windSpeed`
		
		FROM
		`weatherhistory`

	</select>

</mapper>