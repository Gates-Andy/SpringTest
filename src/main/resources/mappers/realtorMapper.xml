<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.andy.test.mvc.repository.RealtorRepository">
	<!-- 1번 -->
	<insert id="insertRealtor"
		parameterType="com.andy.test.mvc.domain.Realtor">
		INSERT INTO
		`realtor`
		(
		`office`
		,`address`
		,`phoneNumber`
		,`grade`
		)
		VALUE
		(
		#{office}
		,#{phoneNumber}
		,#{address}
		,#{grade}
		)
	</insert>
	
</mapper>